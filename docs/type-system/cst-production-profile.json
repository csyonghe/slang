{
  "schemaVersion": {
    "major": 1,
    "minor": 0
  },
  "grammar": "grammar.ebnf",
  "grammarSha256": "ec6d77976897e931daf7233ad0d27765e8e1478da15f2f77de304f3135a4c01b",
  "grammarNamespace": "slang.surface",
  "stage": "Parsed",
  "validationSentinels": [
    "declarationChoice",
    "dottedNameTail",
    "ifStatementExactFields"
  ],
  "wireTags": {
    "algorithm": "sha256-domain-prefix-u32be-v1",
    "namespace": "slang.frontend.cst-production.v1",
    "reserved": [0],
    "collisionRule": "reject",
    "overrides": {
      "nodeKinds": {},
      "fields": {},
      "groups": {},
      "alternatives": {}
    }
  },
  "productionKind": {
    "algorithm": "hyphenated-lower-to-upper-camel-v1",
    "overrides": {
      "source-file": "GrammarRoot",
      "if-statement": "IfStatement"
    }
  },
  "fieldNaming": {
    "algorithm": "source-ordered-leaf-role-v1",
    "collisionRule": "append-one-based-occurrence-from-second-use",
    "softKeywordRule": "logical-spelling-lower-camel-plus-Keyword",
    "literalRoles": {
      "!": "exclamation",
      "!=": "exclamationEqual",
      "$": "dollar",
      "%": "percent",
      "%=": "percentEqual",
      "&": "ampersand",
      "&&": "ampersandAmpersand",
      "&=": "ampersandEqual",
      "(": "leftParenthesis",
      "()": "emptyParentheses",
      ")": "rightParenthesis",
      "*": "asterisk",
      "*=": "asteriskEqual",
      "+": "plus",
      "++": "plusPlus",
      "+=": "plusEqual",
      ",": "comma",
      "-": "minus",
      "--": "minusMinus",
      "-=": "minusEqual",
      "->": "arrow",
      ".": "dot",
      "/": "slash",
      "/=": "slashEqual",
      ":": "colon",
      "::": "scope",
      ";": "semicolon",
      "<": "leftAngle",
      "<<": "shiftLeft",
      "<<=": "shiftLeftEqual",
      "<=": "lessEqual",
      "=": "equal",
      "==": "equalEqual",
      "=>": "fatArrow",
      ">": "rightAngle",
      ">=": "greaterEqual",
      ">>": "shiftRight",
      ">>=": "shiftRightEqual",
      "?": "question",
      "[": "leftBracket",
      "[]": "emptyBrackets",
      "]": "rightBracket",
      "^": "caret",
      "^=": "caretEqual",
      "{": "leftBrace",
      "|": "pipe",
      "|=": "pipeEqual",
      "||": "pipePipe",
      "}": "rightBrace",
      "~": "tilde"
    },
    "terminalRoles": {
      "CHAR_LITERAL": "characterLiteral",
      "END_OF_FILE": "endOfFile",
      "FLOATING_POINT_LITERAL": "floatingPointLiteral",
      "IDENTIFIER": "identifier",
      "INTEGER_LITERAL": "integerLiteral",
      "STRING_LITERAL": "stringLiteral",
      "TOKEN": "token",
      "VIRTUAL_GREATER_FROM_SHIFT_RIGHT": "virtualGreaterFromShiftRight"
    }
  },
  "categoryMembership": {
    "ExprCSTCategory": ["expression", "if-let-binding"],
    "StmtCSTCategory": ["statement"],
    "DeclCSTCategory": ["declaration", "top-level-declaration"]
  },
  "productionOverrides": {
    "if-statement": {
      "exact": true,
      "fields": [
        {
          "name": "ifKeyword",
          "baseType": "TerminalNodeId<{stage}>",
          "select": [{ "kind": "soft", "symbol": "if", "ordinal": 1 }]
        },
        {
          "name": "leftParenthesis",
          "baseType": "TerminalNodeId<{stage}>",
          "select": [{ "kind": "literal", "symbol": "(", "ordinal": 1 }]
        },
        {
          "name": "conditionExpr",
          "baseType": "ExprCSTNodeId<{stage}>",
          "merge": "exclusiveAlternatives",
          "select": [
            { "kind": "nonterminal", "symbol": "expression", "ordinal": 1 },
            { "kind": "nonterminal", "symbol": "if-let-binding", "ordinal": 1 }
          ]
        },
        {
          "name": "rightParenthesis",
          "baseType": "TerminalNodeId<{stage}>",
          "select": [{ "kind": "literal", "symbol": ")", "ordinal": 1 }]
        },
        {
          "name": "trueBranch",
          "baseType": "StmtCSTNodeId<{stage}>",
          "select": [
            { "kind": "nonterminal", "symbol": "statement", "ordinal": 1 }
          ]
        },
        {
          "name": "elseKeyword",
          "baseType": "TerminalNodeId<{stage}>",
          "select": [{ "kind": "soft", "symbol": "else", "ordinal": 1 }]
        },
        {
          "name": "falseBranch",
          "baseType": "StmtCSTNodeId<{stage}>",
          "select": [
            { "kind": "nonterminal", "symbol": "statement", "ordinal": 2 }
          ]
        }
      ],
      "constraints": [
        {
          "kind": "coPresent",
          "fields": ["elseKeyword", "falseBranch"]
        }
      ]
    }
  }
}
